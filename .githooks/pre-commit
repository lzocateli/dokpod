#!/bin/sh
set -eu

command -v docker >/dev/null 2>&1 || {
  echo "Gitleaks obrigatorio: Docker nao foi encontrado no PATH." >&2
  exit 1
}

git diff --cached --no-ext-diff --no-textconv | MSYS_NO_PATHCONV=1 docker run --rm -i --read-only \
  --volume "$(git rev-parse --show-toplevel)/.gitleaks.toml:/gitleaks.toml:ro" \
  lzocateli/gitleaks:8.30.1 \
  stdin --redact --config /gitleaks.toml
